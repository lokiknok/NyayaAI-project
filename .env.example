# NyayaAI Environment Configuration Template
# Copy this file to .env and configure your environment variables.
# NEVER commit .env to source control!

# App Environment (development, testing, production)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# AI Provider Configuration
# Set USE_MOCK_AI=true for offline development, local UI testing without external API keys.
USE_MOCK_AI=true

# AI_PROVIDER options: mock | openai | gemini | anthropic | openrouter | groq
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=3

# Embedding Configuration
# EMBEDDING_PROVIDER options: mock | openai | gemini | huggingface
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Database Configuration
# Local SQLite default: sqlite:///./nyaya_ai.db
# Production PostgreSQL with pgvector: postgresql+psycopg2://user:password@localhost:5432/nyaya_ai
DATABASE_URL=sqlite:///./nyaya_ai.db

# Telegram Bot Configuration
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_RATE_LIMIT_PER_MINUTE=20

# Security & Limits
MAX_UPLOAD_FILE_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,txt
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

